# Copy this file to .env and fill in real values. Never commit .env.

# Binance API
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET_KEY=your-binance-secret-key

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crypgo_machine
DB_USER=postgres
DB_PASSWORD=change-me

# RabbitMQ
RABBIT_MQ_URL=amqp://guest:guest@localhost:5672/

# Email notifications (leave TARGET_EMAIL empty to disable email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=bot@example.com
TARGET_EMAIL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHAT_ID=

# OpenAI / LLM analysis
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_TOKENS=
OPENAI_TEMPERATURE=
USE_LLM_ANALYSIS=false

# Dashboard authentication (required: the app refuses to start without these)
AUTH_EMAIL=admin@example.com
AUTH_PASSWORD=change-me
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Sentiment scheduler (each full analysis calls OpenAI; set to true to enable)
SENTIMENT_SCHEDULER_ENABLED=false

# Futures basis monitor (cmd/basis-monitor, read-only; runs on GitHub Actions).
# It reads these from the process environment, not from .env, and also needs
# TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID unless BASIS_DRY_RUN=true.
BASIS_CURRENCY=BTC
# Gross annualized basis, in percent, that triggers an alert
BASIS_THRESHOLD_PCT=8
# Ignore contracts closer to expiry than this many days
BASIS_MIN_DAYS=30
# Minimum hours between two alerts, unless the basis rises by BASIS_REALERT_STEP_PCT points
BASIS_COOLDOWN_HOURS=24
BASIS_REALERT_STEP_PCT=1
# Alert language: pt-BR or en
BASIS_ALERT_LOCALE=pt-BR
# Where to remember the last alert (empty keeps it in memory only)
BASIS_STATE_FILE=
# true prints the alert instead of sending it
BASIS_DRY_RUN=false
